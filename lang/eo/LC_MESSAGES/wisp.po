msgid "The old start time was kept."
msgstr "La malnova komenco restis."

#: src/app/editor.rs
msgid "Starts: {} Fix it, or press Esc again to keep the old time."
msgstr "Komenco: {} Korektu ĝin, aŭ premu Esc denove por teni la malnovan horon."

#: src/app/editor.rs
msgid "The old due time was kept."
msgstr "La malnova limdato restis."

#: src/app/editor.rs
msgid "Due: {} Fix it, or press Esc again to keep the old time."
msgstr "Limdato: {} Korektu ĝin, aŭ premu Esc denove por teni la malnovan horon."

#: src/app/editor.rs
msgid "The due time is before the start. Fix it, or press Esc again to save it anyway."
msgstr "La limdato estas antaŭ la komenco. Korektu ĝin, aŭ premu Esc denove por tamen konservi."

#: src/app/editor.rs
msgid "Reminder: {} Fix it, or press Esc again to drop it."
msgstr "Memorigo: {} Korektu ĝin, aŭ premu Esc denove por forĵeti ĝin."

#: src/app/editor.rs
msgid "A reminder with no start or due time to follow was left out."
msgid_plural "{} reminders with no start or due time to follow were left out."
msgstr[0] "Memorigo sen komenco aŭ limdato estis preterlasita."
msgstr[1] "{} memorigoj sen komenco aŭ limdato estis preterlasitaj."

#: src/app/editor.rs
msgid "Saved."
msgstr "Konservita."

#: src/app/editor.rs
msgid "start time"
msgstr "komenca horo"

