msgid "A reminder with no start or due time to follow was left out."
msgid_plural "{} reminders with no start or due time to follow were left out."
msgstr[0] "시작이나 마감 시간이 없는 알림 {}개를 뺐습니다."

#: src/app/editor.rs
msgid "Saved."
msgstr "저장했습니다."

#: src/app/editor.rs
