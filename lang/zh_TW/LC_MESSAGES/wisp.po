#. A chrono date pattern: %a is the weekday and %b the month (both from this catalog), %-d the day, %-m the month as a number, %Y the year, %H:%M the time.
#. a weekday and a time, as in "Fri 17:00". %a is the weekday, %H:%M the time.
#: src/dates.rs
msgctxt "date format"
msgid "%a %H:%M"
msgstr "%a %H:%M"

#. A chrono date pattern: %a is the weekday and %b the month (both from this catalog), %-d the day, %-m the month as a number, %Y the year, %H:%M the time.
#. a date this year and a time, as in "Oct 12 09:00". %b is the month, %-d the day.
#: src/dates.rs
msgctxt "date format"
msgid "%b %-d %H:%M"
msgstr "%-m月%-d日 %H:%M"

#. A chrono date pattern: %a is the weekday and %b the month (both from this catalog), %-d the day, %-m the month as a number, %Y the year, %H:%M the time.
#. a date in another year and a time, as in "Jan 3 2027 09:00".
#: src/dates.rs
msgctxt "date format"
msgid "%b %-d %Y %H:%M"
msgstr "%Y年%-m月%-d日 %H:%M"

#. A chrono date pattern: %a is the weekday and %b the month (both from this catalog), %-d the day, %-m the month as a number, %Y the year, %H:%M the time.
#. a day this year, as in "Oct 12". %b is the month, %-d the day.
#: src/dates.rs
msgctxt "date format"
msgid "%b %-d"
msgstr "%-m月%-d日"

#. A chrono date pattern: %a is the weekday and %b the month (both from this catalog), %-d the day, %-m the month as a number, %Y the year, %H:%M the time.
#. a day in another year, as in "Jan 3 2027".
#: src/dates.rs
msgctxt "date format"
msgid "%b %-d %Y"
msgstr "%Y年%-m月%-d日"

#. A chrono date pattern: %a is the weekday and %b the month (both from this catalog), %-d the day, %-m the month as a number, %Y the year, %H:%M the time.
#. the date under the clock, as in "Fri, Oct 9".
#: src/dates.rs
msgctxt "date format"
msgid "%a, %b %-d"
msgstr "%-m月%-d日 %a"

#. A chrono date pattern: %a is the weekday and %b the month (both from this catalog), %-d the day, %-m the month as a number, %Y the year, %H:%M the time.
#. how a typed date was read, as in "Fri Oct 9, 17:00".
#: src/dates.rs
msgctxt "date format"
msgid "%a %b %-d, %H:%M"
msgstr "%-m月%-d日 %a %H:%M"

