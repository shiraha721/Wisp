// Wisp — the look of an index card: ballpoint-blue ink, a red header rule,
// faint blue lines, and a highlighter stroke for whatever is selected.

import { Palette } from "std-widgets.slint";

export enum View { inbox, archive, editor, settings, help }

export struct ItemRow {
    id: int,
    title: string,
    more: bool,
    section: string,
    start: string,
    due: string,
    overdue: bool,
    bells: int,
    ringing: bool,
    note: string,
    top: length,
}

export struct ReminderRow {
    kind-label: string,
    amount: string,
    has-amount: bool,
    placeholder: string,
    fresh: bool,
}

export struct Hint {
    text: string,
    error: bool,
}

export struct SettingRow {
    kind: int, // 0 shortcut, 1 switch, 2 choice, 3 button, 4 folder
    label: string,
    value: string,
    on: bool,
    note: string,
    error: string,
}

export struct HelpRow {
    keys: string,
    label: string,
    section: string,
}

export struct Keys {
    schedule: string,
    open: string,
    done: string,
    delete: string,
    undo: string,
    inbox: string,
    archive: string,
    settings: string,
    help: string,
    add-reminder: string,
    quit: string,
}

struct KeyHint {
    keys: string,
    label: string,
}

export global Theme {
    in property <int> choice; // 0 follow the system, 1 light, 2 dark
    out property <bool> dark: choice == 2 || (choice == 0 && Palette.color-scheme == ColorScheme.dark);

    out property <color> paper: dark ? #1a2030 : #fcfdff;
    out property <color> paper-sunk: dark ? #151a27 : #f2f5fa;
    out property <color> rule: dark ? #273047 : #e2e9f3;
    out property <color> border: dark ? #34405c : #c8d2e1;
    out property <color> margin: dark ? #ff707a : #df4f5a;
    out property <color> margin-faint: dark ? #ff707a38 : #df4f5a30;
    out property <color> ink: dark ? #e8ecf6 : #1c2540;
    out property <color> ink-soft: dark ? #aeb7cb : #4b5772;
    out property <color> pencil: dark ? #7f89a1 : #858ea4;
    out property <color> ballpoint: dark ? #93abff : #2a4fcc;
    out property <color> highlighter: dark ? #ffd9452e : #fff0a3;

    out property <length> pad: 22px;
    out property <length> margin-x: 112px; // where the red margin line runs in forms
    out property <length> row-h: 42px;
    out property <length> section-h: 30px;
}

// ---------------------------------------------------------------------------
// Small pieces

component Keycap inherits Rectangle {
    in property <string> text;
    in property <bool> live;
    height: 20px;
    width: label.preferred-width + 12px;
    border-radius: 4px;
    border-width: 1px;
    border-color: live ? Theme.ballpoint : Theme.border;
    background: Theme.paper-sunk;
    label := Text {
        text: root.text;
        font-size: 11px;
        color: root.live ? Theme.ballpoint : Theme.ink-soft;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component KeyHintView inherits HorizontalLayout {
    in property <string> keys;
    in property <string> label;
    spacing: 6px;
    VerticalLayout {
        alignment: center;
        Keycap { text: root.keys; }
    }
    Text {
        text: root.label;
        font-size: 12px;
        color: Theme.pencil;
        vertical-alignment: center;
    }
}

component Bell inherits Path {
    width: 13px;
    height: 13px;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke-width: 1.4px;
    fill: transparent;
    stroke-line-join: round;
    commands: "M8 2 C5.6 2 4.2 3.8 4.2 6.1 L4.2 8.6 L2.8 11 L13.2 11 L11.8 8.6 L11.8 6.1 C11.8 3.8 10.4 2 8 2 Z M6.5 13.2 C6.9 14.1 9.1 14.1 9.5 13.2";
}

component Cross inherits Path {
    width: 10px;
    height: 10px;
    viewbox-width: 10;
    viewbox-height: 10;
    stroke-width: 1.4px;
    stroke-line-cap: round;
    commands: "M1.5 1.5 L8.5 8.5 M8.5 1.5 L1.5 8.5";
}

// The round tick at the start of each line.
component Tick inherits Rectangle {
    in property <bool> done;
    in property <bool> ringing;
    in property <bool> marked;
    callback toggled();
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border-width: 1.5px;
    border-color: root.done ? Theme.ballpoint : root.ringing ? Theme.margin : touch.has-hover ? Theme.ballpoint : root.marked ? Theme.ink-soft : Theme.border;
    background: root.done ? Theme.ballpoint : transparent;
    if root.done || touch.has-hover : Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M4.6 8.3 L7 10.6 L11.5 5.6";
        stroke: root.done ? Theme.paper : Theme.ballpoint;
        stroke-width: 1.6px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// A multi-line input that grows with its text, up to `max-height`.
component Scribble inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <length> font-size: 20px;
    in property <length> limit: 120px;
    in property <bool> active: true;
    out property <bool> has-focus: input.has-focus;
    callback edited();
    property <length> line: root.font-size * 1.4;

    public function take-focus() {
        input.focus();
    }
    public function cursor-to-end() {
        input.set-selection-offsets(2147483647, 2147483647);
    }

    height: min(max(input.preferred-height, root.line), root.limit);

    flick := Flickable {
        width: parent.width;
        height: parent.height;
        content-width: self.width;
        content-height: max(input.preferred-height, self.height);
        interactive: false;

        input := TextInput {
            width: flick.width;
            height: flick.content-height;
            single-line: false;
            wrap: word-wrap;
            enabled: root.active;
            font-size: root.font-size;
            color: Theme.ballpoint;
            selection-background-color: Theme.highlighter;
            selection-foreground-color: Theme.ink;
            text-cursor-width: 2px;
            edited => { root.edited(); }
            cursor-position-changed(p) => {
                if p.y < -flick.content-y {
                    flick.content-y = -p.y;
                } else if p.y + root.line > -flick.content-y + flick.height {
                    flick.content-y = -(p.y + root.line - flick.height);
                }
            }
        }
    }

    if input.text == "" : Text {
        x: 0;
        y: 0;
        text: root.placeholder;
        font-size: root.font-size;
        color: Theme.pencil;
    }
}

// ---------------------------------------------------------------------------
// The list

component NoteLine inherits Rectangle {
    in property <ItemRow> item;
    in property <bool> selected;
    in property <bool> archived;
    callback select();
    callback open();
    callback toggle();
    property <length> head: root.item.section != "" ? Theme.section-h : 0px;
    height: root.head + Theme.row-h;

    if root.item.section != "" : Text {
        x: Theme.pad;
        y: 0;
        width: root.width - 2 * Theme.pad;
        height: Theme.section-h - 5px;
        text: root.item.section;
        color: Theme.margin;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: bottom;
    }

    Rectangle {
        y: root.head;
        width: root.width;
        height: Theme.row-h;

        // The highlighter stroke sweeps in from the left.
        Rectangle {
            x: Theme.pad - 9px;
            y: 6px;
            height: parent.height - 12px;
            width: root.selected ? parent.width - 2 * (Theme.pad - 9px) : 0px;
            animate width { duration: 170ms; easing: ease-out; }
            background: Theme.highlighter;
            border-radius: 3px;
        }
        Rectangle {
            x: 0;
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: Theme.rule;
        }
        TouchArea {
            clicked => { root.select(); }
            double-clicked => { root.open(); }
        }
        HorizontalLayout {
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            spacing: 12px;

            VerticalLayout {
                alignment: center;
                Tick {
                    done: root.archived;
                    marked: root.selected;
                    ringing: root.item.ringing;
                    toggled => { root.toggle(); }
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.item.more ? root.item.title + "  …" : root.item.title;
                color: root.archived ? Theme.ink-soft : Theme.ink;
                font-size: 14px;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.item.start != "" : Text {
                text: root.item.start;
                color: Theme.pencil;
                font-size: 12px;
                vertical-alignment: center;
            }
            if root.item.due != "" : Text {
                text: root.item.due;
                color: root.item.overdue ? Theme.margin : Theme.ink-soft;
                font-weight: root.item.overdue ? 600 : 400;
                font-size: 12px;
                vertical-alignment: center;
            }
            if root.item.bells > 0 : HorizontalLayout {
                spacing: 3px;
                VerticalLayout {
                    alignment: center;
                    Bell { stroke: root.item.ringing ? Theme.margin : Theme.pencil; }
                }
                if root.item.bells > 1 : Text {
                    text: root.item.bells;
                    color: Theme.pencil;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
            if root.item.note != "" : Text {
                text: root.item.note;
                color: Theme.pencil;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The editor: one ruled line per field, labels in the margin.

component RuledLine inherits Rectangle {
    in property <string> label;
    height: Theme.row-h;
    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.rule;
    }
    Text {
        x: Theme.pad;
        width: Theme.margin-x - Theme.pad - 12px;
        height: parent.height;
        text: root.label;
        color: Theme.margin;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
}

component DateField inherits RuledLine {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <Hint> hint;
    in property <bool> active;
    out property <bool> has-focus: input.has-focus;
    callback edited();

    public function take-focus() {
        input.focus();
        input.select-all();
    }

    input := TextInput {
        x: Theme.margin-x + 12px;
        width: 200px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        enabled: root.active;
        color: Theme.ballpoint;
        font-size: 14px;
        selection-background-color: Theme.highlighter;
        selection-foreground-color: Theme.ink;
        text-cursor-width: 2px;
        edited => { root.edited(); }
    }
    if input.text == "" : Text {
        x: input.x;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.pencil;
        font-size: 14px;
    }
    Rectangle {
        x: input.x;
        y: parent.height - 2px;
        width: input.width;
        height: 2px;
        background: input.has-focus ? Theme.ballpoint : transparent;
    }
    Text {
        x: input.x + input.width + 12px;
        width: parent.width - self.x - Theme.pad;
        height: parent.height;
        horizontal-alignment: right;
        vertical-alignment: center;
        text: root.hint.text;
        color: root.hint.error ? Theme.margin : Theme.pencil;
        font-size: 12px;
        overflow: elide;
    }
}

component ReminderLine inherits RuledLine {
    in property <ReminderRow> data;
    in-out property <string> amount;
    in property <Hint> hint;
    in property <bool> active;
    callback cycle(int);
    callback remove();
    callback edited();

    init => {
        if root.data.fresh {
            picker.focus();
        }
    }

    picker := FocusScope {
        x: Theme.margin-x + 6px;
        width: 140px;
        height: parent.height;
        enabled: root.active;
        key-pressed(e) => {
            if e.text == Key.LeftArrow {
                root.cycle(-1);
                return accept;
            }
            if e.text == Key.RightArrow || e.text == " " {
                root.cycle(1);
                return accept;
            }
            if e.text == Key.Delete || e.text == Key.Backspace {
                root.remove();
                return accept;
            }
            reject
        }
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: 26px;
            border-radius: 4px;
            background: picker.has-focus ? Theme.highlighter : transparent;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                Text {
                    text: "‹";
                    color: Theme.pencil;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.data.kind-label;
                    color: Theme.ink;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    text: "›";
                    color: Theme.pencil;
                    vertical-alignment: center;
                }
            }
        }
        TouchArea {
            clicked => {
                picker.focus();
                root.cycle(1);
            }
        }
    }

    amount-input := TextInput {
        x: picker.x + picker.width + 10px;
        width: 72px;
        height: parent.height;
        visible: root.data.has-amount;
        enabled: root.active && root.data.has-amount;
        vertical-alignment: center;
        single-line: true;
        text <=> root.amount;
        color: Theme.ballpoint;
        font-size: 14px;
        selection-background-color: Theme.highlighter;
        selection-foreground-color: Theme.ink;
        text-cursor-width: 2px;
        edited => { root.edited(); }
    }
    if root.data.has-amount && root.amount == "" : Text {
        x: amount-input.x;
        height: parent.height;
        vertical-alignment: center;
        text: root.data.placeholder;
        color: Theme.pencil;
        font-size: 13px;
    }
    Rectangle {
        x: amount-input.x;
        y: parent.height - 2px;
        width: amount-input.width;
        height: 2px;
        background: amount-input.has-focus ? Theme.ballpoint : transparent;
    }
    Text {
        x: amount-input.x + amount-input.width + 10px;
        width: parent.width - self.x - Theme.pad - 26px;
        height: parent.height;
        horizontal-alignment: right;
        vertical-alignment: center;
        text: root.hint.text;
        color: root.hint.error ? Theme.margin : Theme.pencil;
        font-size: 12px;
        overflow: elide;
    }
    Rectangle {
        x: parent.width - Theme.pad - 16px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        Cross {
            stroke: remove-touch.has-hover ? Theme.margin : Theme.pencil;
        }
        remove-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.remove(); }
        }
    }
}

component EditorPane inherits Rectangle {
    in-out property <string> start;
    in-out property <string> due;
    in property <Hint> start-hint;
    in property <Hint> due-hint;
    in property <[ReminderRow]> reminders;
    in property <[Hint]> reminder-hints;
    in property <bool> active;
    in property <string> add-keys;
    out property <bool> start-focused: start-field.has-focus;
    out property <bool> due-focused: due-field.has-focus;
    out property <bool> add-focused: add.has-focus;
    callback edited();
    callback cycle(int, int);
    callback remove(int);
    callback add-reminder();

    public function focus-start() {
        start-field.take-focus();
    }
    public function focus-due() {
        due-field.take-focus();
    }
    public function focus-add() {
        add.focus();
    }

    // The notebook margin.
    Rectangle {
        x: Theme.margin-x;
        width: 1px;
        background: Theme.margin-faint;
    }

    Flickable {
        content-height: (root.reminders.length + 3) * Theme.row-h;
        VerticalLayout {
            alignment: LayoutAlignment.start;
            start-field := DateField {
                label: "Starts";
                text <=> root.start;
                placeholder: "tomorrow 9am, fri 14:00, +2h";
                hint: root.start-hint;
                active: root.active;
                edited => { root.edited(); }
            }
            due-field := DateField {
                label: "Due";
                text <=> root.due;
                placeholder: "fri 17:00, 10-20, next mon";
                hint: root.due-hint;
                active: root.active;
                edited => { root.edited(); }
            }
            for r[i] in root.reminders : ReminderLine {
                label: i == 0 ? "Remind me" : "";
                data: r;
                amount <=> r.amount;
                hint: i < root.reminder-hints.length ? root.reminder-hints[i] : { text: "", error: false };
                active: root.active;
                cycle(d) => { root.cycle(i, d); }
                remove => { root.remove(i); }
                edited => { root.edited(); }
            }
            RuledLine {
                label: root.reminders.length == 0 ? "Remind me" : "";
                add := FocusScope {
                    x: Theme.margin-x + 6px;
                    width: add-label.preferred-width + 60px;
                    enabled: root.active;
                    key-pressed(e) => {
                        if e.text == Key.Return || e.text == " " {
                            root.add-reminder();
                            return accept;
                        }
                        reject
                    }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 26px;
                        border-radius: 4px;
                        background: add.has-focus ? Theme.highlighter : transparent;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 8px;
                            add-label := Text {
                                text: "+ Add a reminder";
                                color: Theme.ballpoint;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Keycap { text: root.add-keys; }
                            }
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.add-reminder(); }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Settings: one keyboard cursor moves over the rows; Rust handles the keys.

component Switch inherits Rectangle {
    in property <bool> on;
    width: 30px;
    height: 18px;
    border-radius: 9px;
    background: root.on ? Theme.ballpoint : Theme.border;
    animate background { duration: 120ms; }
    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        animate x { duration: 120ms; easing: ease-out; }
        y: 2px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.on || !Theme.dark ? #ffffff : Theme.ink-soft;
    }
}

component SettingsPane inherits FocusScope {
    in property <[SettingRow]> rows;
    in property <int> index;
    in property <bool> recording;
    callback clicked(int);
    property <length> line: 40px;
    focus-on-click: true;

    changed index => {
        if root.index * root.line < -flick.content-y {
            flick.content-y = -root.index * root.line;
        } else if (root.index + 1) * root.line > -flick.content-y + flick.height {
            flick.content-y = -((root.index + 1) * root.line - flick.height);
        }
    }

    flick := Flickable {
        content-height: root.rows.length * root.line + 8px;
        for r[i] in root.rows : setting-line := Rectangle {
            y: i * root.line;
            height: root.line;
            width: flick.width;
            property <bool> current: i == root.index;

            Rectangle {
                x: Theme.pad - 9px;
                y: 5px;
                height: parent.height - 10px;
                width: parent.current && root.has-focus ? parent.width - 2 * (Theme.pad - 9px) : 0px;
                animate width { duration: 170ms; easing: ease-out; }
                background: Theme.highlighter;
                border-radius: 3px;
            }
            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.rule;
            }
            TouchArea {
                clicked => {
                    root.focus();
                    root.clicked(i);
                }
            }
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                spacing: 10px;
                Text {
                    text: r.label;
                    color: r.kind == 4 ? Theme.ink-soft : Theme.ink;
                    font-size: 13.5px;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: r.error != "" ? r.error : r.note;
                    color: r.error != "" ? Theme.margin : Theme.pencil;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-alignment: r.kind == 4 ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
                    overflow: elide;
                }
                if r.kind == 0 : VerticalLayout {
                    alignment: center;
                    Keycap {
                        text: root.recording && setting-line.current ? "Press the new keys" : r.value;
                        live: root.recording && setting-line.current;
                    }
                }
                if r.kind == 1 : VerticalLayout {
                    alignment: center;
                    Switch { on: r.on; }
                }
                if r.kind == 2 : Text {
                    text: "‹ " + r.value + " ›";
                    color: Theme.ink;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                if r.kind == 3 || r.kind == 4 : Text {
                    text: r.value;
                    color: Theme.ballpoint;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component HelpPane inherits FocusScope {
    in property <[HelpRow]> rows;
    property <length> line: 32px;
    property <length> head: 30px;
    focus-on-click: true;

    key-pressed(e) => {
        if e.text == Key.DownArrow || e.text == Key.PageDown {
            flick.content-y = max(flick.content-y - (e.text == Key.PageDown ? flick.height : root.line * 3), flick.height - flick.content-height);
            return accept;
        }
        if e.text == Key.UpArrow || e.text == Key.PageUp {
            flick.content-y = min(flick.content-y + (e.text == Key.PageUp ? flick.height : root.line * 3), 0px);
            return accept;
        }
        reject
    }

    flick := Flickable {
        content-height: lines.preferred-height + 12px;
        lines := VerticalLayout {
            alignment: start;
            for r in root.rows : VerticalLayout {
                if r.section != "" : Text {
                    height: root.head;
                    x: Theme.pad;
                    text: r.section;
                    color: Theme.margin;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: bottom;
                }
                Rectangle {
                    height: root.line;
                    Rectangle {
                        x: 0;
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.rule;
                    }
                    HorizontalLayout {
                        padding-left: Theme.pad;
                        padding-right: Theme.pad;
                        Text {
                            horizontal-stretch: 1;
                            text: r.label;
                            color: Theme.ink;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Keycap { text: r.keys; }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------

export component AppWindow inherits Window {
    title: "Wisp";
    icon: root.app-icon;
    no-frame: true;
    always-on-top: true;
    width: 640px;
    height: 480px;
    background: Theme.paper;
    default-font-size: 14px;

    in property <image> app-icon;
    in-out property <View> view: View.inbox;

    in-out property <string> query;
    in property <[ItemRow]> items;
    in property <length> list-height;
    in-out property <int> selected: -1;
    in property <string> badge;
    in property <string> empty-title;
    in property <string> empty-body;

    in-out property <string> edit-text;
    in-out property <string> edit-start;
    in-out property <string> edit-due;
    in property <string> edit-meta;
    in property <Hint> start-hint;
    in property <Hint> due-hint;
    in property <[ReminderRow]> reminders;
    in property <[Hint]> reminder-hints;

    in property <[SettingRow]> settings;
    in property <int> setting-index;
    in property <bool> recording;
    in property <[HelpRow]> help;

    in property <Keys> keys;
    in property <string> toast;
    in property <bool> toast-error;

    // Every key press goes to Rust first, with where focus is; `true` means handled.
    callback key(text: string, ctrl: bool, alt: bool, shift: bool, meta: bool, context: string) -> bool;
    callback query-edited();
    callback row-clicked(int);
    callback row-opened(int);
    callback row-toggled(int);
    callback badge-clicked();
    callback editor-edited();
    callback reminder-cycle(int, int);
    callback reminder-remove(int);
    callback reminder-add();
    callback setting-clicked(int);

    public function focus-capture() {
        capture.take-focus();
        capture.cursor-to-end();
    }
    public function focus-editor(field: int) {
        if field == 1 {
            editor.focus-start();
        } else if field == 2 {
            editor.focus-due();
        } else if field == 3 {
            editor.focus-add();
        } else {
            note-text.take-focus();
            note-text.cursor-to-end();
        }
    }
    public function focus-settings() {
        settings-pane.focus();
    }
    public function focus-help() {
        help-pane.focus();
    }

    property <bool> listing: root.view == View.inbox || root.view == View.archive;

    pure function context() -> string {
        if capture.has-focus {
            return "capture";
        }
        if note-text.has-focus {
            return "edit-text";
        }
        if root.view == View.editor {
            return editor.add-focused ? "edit-add" : "editor";
        }
        if root.view == View.settings {
            return "settings";
        }
        if root.view == View.help {
            return "help";
        }
        return "";
    }

    function scroll-to-selection() {
        if root.selected < 0 {
            list.content-y = 0;
        } else if root.selected < root.items.length {
            let r = root.items[root.selected];
            let bottom = r.top + (r.section != "" ? Theme.section-h : 0px) + Theme.row-h;
            if r.top < -list.content-y {
                list.content-y = -r.top;
            } else if bottom > -list.content-y + list.height {
                list.content-y = -(bottom - list.height);
            }
        }
    }
    changed selected => { root.scroll-to-selection(); }
    changed items => { root.scroll-to-selection(); }

    property <[KeyHint]> hints: root.view == View.editor ? [
        { keys: "Esc", label: "Save and close" },
        { keys: root.keys.add-reminder, label: "Add a reminder" },
        { keys: root.keys.done, label: "Mark done" },
        { keys: "Tab", label: "Next field" },
    ] : root.view == View.settings ? (root.recording ? [
        { keys: "Esc", label: "Keep the old keys" },
    ] : [
        { keys: "↑ ↓", label: "Move" },
        { keys: "Enter", label: "Change" },
        { keys: "Backspace", label: "Use default" },
        { keys: "Esc", label: "Back" },
    ]) : root.view == View.help ? [
        { keys: "Esc", label: "Back" },
        { keys: "↑ ↓", label: "Scroll" },
    ] : root.selected >= 0 ? [
        { keys: "Enter", label: "Open" },
        { keys: root.keys.done, label: root.view == View.archive ? "Bring back" : "Mark done" },
        { keys: root.keys.delete, label: "Delete" },
        { keys: "Esc", label: "Back to typing" },
    ] : root.view == View.archive ? [
        { keys: "↓", label: "Browse" },
        { keys: root.keys.inbox, label: "Back to notes" },
        { keys: root.keys.help, label: "Shortcuts" },
    ] : [
        { keys: "Enter", label: "Save" },
        { keys: root.keys.schedule, label: "Save with a date" },
        { keys: "↓", label: "Browse" },
        { keys: root.keys.help, label: "Shortcuts" },
    ];

    router := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(e) => {
            if root.key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta, root.context()) {
                return accept;
            }
            reject
        }

        Rectangle {
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.paper;

            VerticalLayout {
                padding: 1px;

                // Header: where you write.
                header := Rectangle {
                    height: max(62px, (root.listing ? capture.height : root.view == View.editor ? note-text.height : 28px) + 34px);

                    capture := Scribble {
                        x: Theme.pad;
                        y: 17px;
                        width: parent.width - 2 * Theme.pad - badge.width - 16px;
                        visible: root.listing;
                        active: root.listing;
                        placeholder: root.view == View.archive ? "Search what's done" : "Type a thought. Enter saves it.";
                        text <=> root.query;
                        edited => { root.query-edited(); }
                    }
                    note-text := Scribble {
                        x: Theme.pad;
                        y: 17px;
                        width: parent.width - 2 * Theme.pad - meta.width - 16px;
                        font-size: 18px;
                        limit: 150px;
                        visible: root.view == View.editor;
                        active: root.view == View.editor;
                        placeholder: "Write the note";
                        text <=> root.edit-text;
                        edited => { root.editor-edited(); }
                    }
                    if root.view == View.settings || root.view == View.help : Text {
                        x: Theme.pad;
                        y: 17px;
                        text: root.view == View.settings ? "Settings" : "Keyboard shortcuts";
                        font-size: 20px;
                        color: Theme.ink;
                    }
                    badge := Text {
                        x: parent.width - self.width - Theme.pad;
                        y: 24px;
                        visible: root.listing;
                        text: root.badge;
                        color: badge-touch.has-hover ? Theme.ballpoint : Theme.pencil;
                        font-size: 12px;
                        badge-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.badge-clicked(); }
                        }
                    }
                    meta := Text {
                        x: parent.width - self.width - Theme.pad;
                        y: 22px;
                        visible: root.view == View.editor;
                        text: root.edit-meta;
                        color: Theme.pencil;
                        font-size: 12px;
                    }
                }

                // The red rule of an index card.
                Rectangle {
                    height: 2px;
                    background: Theme.margin;
                }

                Rectangle {
                    vertical-stretch: 1;
                    clip: true;

                    list := Flickable {
                        visible: root.listing;
                        content-height: max(root.list-height + 8px, self.height);
                        // Ruled lines carry on below the last note.
                        for i in 16 : Rectangle {
                            x: 0;
                            y: root.list-height + (i + 1) * Theme.row-h - 1px;
                            width: list.width;
                            height: 1px;
                            background: Theme.rule;
                        }
                        for row[i] in root.items : NoteLine {
                            x: 0;
                            y: row.top;
                            width: list.width;
                            item: row;
                            selected: i == root.selected;
                            archived: root.view == View.archive;
                            select => { root.row-clicked(i); }
                            open => { root.row-opened(i); }
                            toggle => { root.row-toggled(i); }
                        }
                    }
                    if root.listing && root.items.length == 0 : Rectangle {
                        Text {
                            x: Theme.pad;
                            y: Theme.row-h - self.height - 8px;
                            text: root.empty-title;
                            color: Theme.ink-soft;
                            font-size: 15px;
                        }
                        Text {
                            x: Theme.pad;
                            y: 2 * Theme.row-h - self.height - 9px;
                            width: parent.width - 2 * Theme.pad;
                            text: root.empty-body;
                            color: Theme.pencil;
                            font-size: 13px;
                            overflow: elide;
                        }
                    }

                    editor := EditorPane {
                        visible: root.view == View.editor;
                        active: root.view == View.editor;
                        start <=> root.edit-start;
                        due <=> root.edit-due;
                        start-hint: root.start-hint;
                        due-hint: root.due-hint;
                        reminders: root.reminders;
                        reminder-hints: root.reminder-hints;
                        add-keys: root.keys.add-reminder;
                        edited => { root.editor-edited(); }
                        cycle(i, d) => { root.reminder-cycle(i, d); }
                        remove(i) => { root.reminder-remove(i); }
                        add-reminder => { root.reminder-add(); }
                    }

                    settings-pane := SettingsPane {
                        visible: root.view == View.settings;
                        enabled: root.view == View.settings;
                        rows: root.settings;
                        index: root.setting-index;
                        recording: root.recording;
                        clicked(i) => { root.setting-clicked(i); }
                    }

                    help-pane := HelpPane {
                        visible: root.view == View.help;
                        enabled: root.view == View.help;
                        rows: root.help;
                    }
                }

                // Footer: what the keys do right now, or the latest news.
                Rectangle {
                    height: 38px;
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: 1px;
                        background: Theme.rule;
                    }
                    HorizontalLayout {
                        padding-left: Theme.pad;
                        padding-right: Theme.pad;
                        spacing: 18px;
                        alignment: start;
                        if root.toast != "" : Text {
                            text: root.toast;
                            color: root.toast-error ? Theme.margin : Theme.ballpoint;
                            font-size: 12.5px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if root.toast == "" : HorizontalLayout {
                            spacing: 18px;
                            for h in root.hints : KeyHintView {
                                keys: h.keys;
                                label: h.label;
                            }
                        }
                    }
                }
            }
        }
    }
}

// The tray icon and its menu.
export component Tray inherits SystemTrayIcon {
    in property <image> app-icon;
    in property <string> summon-label;
    callback open-app();
    callback open-settings();
    callback quit-app();

    icon: root.app-icon;
    tooltip: "Wisp — " + root.summon-label;
    title: "Wisp";
    clicked => { root.open-app(); }

    Menu {
        MenuItem {
            title: "Open Wisp (" + root.summon-label + ")";
            activated => { root.open-app(); }
        }
        MenuItem {
            title: "Settings";
            activated => { root.open-settings(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Quit Wisp";
            activated => { root.quit-app(); }
        }
    }
}
