// Everything Rust sees: the launcher, the settings window and the tray icon.

export { Theme, Glyph } from "theme.slint";
export { ItemRow, ReminderRow, Hint, HelpRow, Keys, NavItem, SettingCard, CategoryChip } from "types.slint";
export { AppWindow, View } from "launcher.slint";
export { SettingsWindow } from "settings.slint";

export component Tray inherits SystemTrayIcon {
    in property <image> app-icon;
    in property <string> summon-label;
    callback open-app();
    callback open-settings();
    callback quit-app();

    icon: root.app-icon;
    tooltip: "Wisp (" + root.summon-label + ")";
    title: "Wisp";
    clicked => { root.open-app(); }

    Menu {
        MenuItem {
            title: "Open Wisp (" + root.summon-label + ")";
            activated => { root.open-app(); }
        }
        MenuItem {
            title: "Settings";
            activated => { root.open-settings(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Quit Wisp";
            activated => { root.quit-app(); }
        }
    }
}
