// The launcher: a search-box-style header, the notes list, the note editor and
// the shortcut list, modelled on Flow Launcher's main window.

import { Theme, Glyph, Icon } from "theme.slint";
import { Keycap, KeyHintView, Tile, Card, IconButton, Meta, Scribble, InputBox } from "widgets.slint";
import { ItemRow, ReminderRow, Hint, HelpRow, Keys, KeyHint } from "types.slint";

export enum View { inbox, archive, editor, help }

component TabButton inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <bool> active;
    callback clicked();
    height: 38px;
    width: row.preferred-width;
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.active ? 600 : 400;
            color: root.active || touch.has-hover ? Theme.text : Theme.text-2;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                width: max(20px, count-label.preferred-width + 10px);
                border-radius: 9px;
                background: root.active ? Theme.accent-soft : Theme.neutral-soft;
                count-label := Text {
                    text: root.count;
                    font-size: 11px;
                    color: root.active ? Theme.accent : Theme.text-3;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    Rectangle {
        x: 10px;
        y: parent.height - 3px;
        height: 3px;
        border-radius: 1.5px;
        width: root.active ? parent.width - 20px : 0px;
        animate width { duration: 150ms; easing: ease-out; }
        background: Theme.accent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component NoteLine inherits Rectangle {
    in property <ItemRow> item;
    in property <bool> selected;
    callback select();
    callback open();
    callback toggle();
    property <length> head: root.item.section != "" ? Theme.section-h : 0px;
    property <bool> has-subtitle: root.item.start != "" || root.item.due != "" || root.item.bells > 0 || root.item.preview != "";
    height: root.head + Theme.row-h;

    if root.item.section != "" : Text {
        x: 22px;
        y: 0;
        width: root.width - 44px;
        height: Theme.section-h - 6px;
        text: root.item.section;
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-3;
        vertical-alignment: bottom;
    }

    Rectangle {
        x: 8px;
        y: root.head + 2px;
        width: root.width - 16px;
        height: Theme.row-h - 4px;
        border-radius: 7px;
        background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;

        // The accent bar of the selected result.
        Rectangle {
            x: 0;
            width: 3px;
            height: root.selected ? 20px : 0px;
            y: (parent.height - self.height) / 2;
            animate height { duration: 140ms; easing: ease-out; }
            border-radius: 1.5px;
            background: Theme.accent;
        }
        touch := TouchArea {
            clicked => { root.select(); }
            double-clicked => { root.open(); }
        }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 14px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Tile {
                    glyph: root.item.kind == 4 ? Glyph.check : root.item.kind == 2 ? Glyph.bell : root.item.kind == 3 ? Glyph.clock : root.item.kind == 1 ? Glyph.calendar : Glyph.note;
                    tone: root.item.kind == 4 ? 3 : (root.item.kind == 2 || root.item.kind == 3) ? 2 : root.item.kind == 1 ? 1 : 0;
                    hot: tile-touch.has-hover;
                    tile-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle(); }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                Text {
                    text: root.item.title;
                    font-size: 14px;
                    color: root.item.kind == 4 ? Theme.text-2 : Theme.text;
                    overflow: elide;
                }
                if root.has-subtitle : HorizontalLayout {
                    spacing: 12px;
                    if root.item.start != "" : Meta {
                        glyph: Glyph.calendar;
                        text: root.item.start;
                    }
                    if root.item.due != "" : Meta {
                        glyph: Glyph.flag;
                        text: root.item.due;
                        alert: root.item.overdue;
                    }
                    if root.item.bells > 0 : Meta {
                        glyph: Glyph.bell;
                        text: root.item.bells;
                        alert: root.item.ringing;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.item.preview;
                        font-size: 12px;
                        color: Theme.text-3;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            if root.item.note != "" : VerticalLayout {
                alignment: center;
                Text {
                    text: root.item.note;
                    font-size: 11.5px;
                    color: Theme.text-3;
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The editor

component DateRow inherits Rectangle {
    in property <Glyph> glyph;
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    in property <Hint> hint;
    in property <bool> active;
    out property <bool> has-focus: box.has-focus;
    callback edited();
    callback focused();

    public function take-focus() {
        box.take-focus();
    }
    changed has-focus => {
        if self.has-focus {
            root.focused();
        }
    }

    height: 46px;
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                glyph: root.glyph;
                icon-size: 16px;
            }
        }
        Text {
            width: 52px;
            text: root.label;
            font-size: 13px;
            color: Theme.text;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            box := InputBox {
                width: 214px;
                text <=> root.text;
                placeholder: root.placeholder;
                active: root.active;
                edited => { root.edited(); }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.hint.text;
            color: root.hint.error ? Theme.danger : Theme.text-3;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component ReminderLine inherits Rectangle {
    in property <ReminderRow> data;
    in-out property <string> amount;
    in property <Hint> hint;
    in property <bool> active;
    out property <bool> kind-focused: picker.has-focus;
    out property <bool> amount-focused: amount-box.has-focus;
    callback cycle(int);
    callback remove();
    callback edited();
    // Focus given in `init` doesn't trigger `changed` handlers, so it's reported here.
    callback took-focus();

    init => {
        if root.data.fresh {
            picker.focus();
            root.took-focus();
        }
    }

    height: 40px;
    HorizontalLayout {
        padding-left: 26px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            picker := FocusScope {
                width: 150px;
                height: 30px;
                enabled: root.active;
                // Normally Rust handles these keys first; this is the fallback.
                key-pressed(e) => {
                    if e.text == Key.LeftArrow {
                        root.cycle(-1);
                        return accept;
                    }
                    if e.text == Key.RightArrow || e.text == " " {
                        root.cycle(1);
                        return accept;
                    }
                    if e.text == Key.Delete || e.text == Key.Backspace {
                        root.remove();
                        return accept;
                    }
                    reject
                }
                Rectangle {
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: picker.has-focus ? Theme.accent : Theme.stroke;
                    background: picker.has-focus ? Theme.accent-soft : Theme.field;
                    HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 9px;
                        Text {
                            text: "‹";
                            color: Theme.text-3;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.data.kind-label;
                            color: Theme.text;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "›";
                            color: Theme.text-3;
                            vertical-alignment: center;
                        }
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        picker.focus();
                        root.cycle(1);
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            amount-box := InputBox {
                width: root.data.has-amount ? 78px : 0px;
                visible: root.data.has-amount;
                active: root.active && root.data.has-amount;
                text <=> root.amount;
                placeholder: root.data.placeholder;
                edited => { root.edited(); }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.hint.text;
            color: root.hint.error ? Theme.danger : Theme.text-3;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 5px;
                background: remove-touch.has-hover ? Theme.danger-soft : transparent;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    glyph: Glyph.cross;
                    icon-size: 14px;
                    tint: remove-touch.has-hover ? Theme.danger : Theme.text-3;
                }
                remove-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.remove(); }
                }
            }
        }
    }
}

component EditorPane inherits Rectangle {
    in-out property <string> notes;
    in-out property <string> start;
    in-out property <string> due;
    in property <Hint> start-hint;
    in property <Hint> due-hint;
    in property <[ReminderRow]> reminders;
    in property <[Hint]> reminder-hints;
    in property <bool> active;
    in property <bool> can-add;
    in property <string> add-keys;
    out property <bool> notes-focused: notes-box.has-focus;
    out property <bool> date-focused: start-row.has-focus || due-row.has-focus;
    out property <bool> add-focused: add.has-focus;
    in-out property <int> focused-reminder: -1;
    in-out property <int> focused-part: 0;
    callback edited();
    callback cycle(int, int);
    callback remove(int);
    callback add-reminder();

    public function focus-notes() {
        notes-box.take-focus();
        notes-box.cursor-to-end();
    }
    public function focus-start() {
        start-row.take-focus();
    }
    public function focus-due() {
        due-row.take-focus();
    }
    public function focus-add() {
        add.focus();
    }

    // Scrolls so that something at window position `y` with height `h` is visible.
    function reveal(y: length, h: length) {
        let top = y - flick.absolute-position.y;
        if top < 0 {
            flick.content-y = min(0px, flick.content-y - top);
        } else if top + h > flick.height {
            flick.content-y = max(flick.height - flick.content-height, flick.content-y - (top + h - flick.height));
        }
    }
    function track(i: int, kind: bool, amount: bool, y: length, h: length) {
        if kind || amount {
            root.focused-reminder = i;
            root.focused-part = kind ? 0 : 1;
            root.reveal(y, h);
        } else if root.focused-reminder == i {
            root.focused-reminder = -1;
        }
    }

    flick := Flickable {
        content-height: column.preferred-height;
        column := VerticalLayout {
            padding: 12px;
            spacing: 10px;
            alignment: LayoutAlignment.start;

            Card {
                VerticalLayout {
                    padding: 12px;
                    padding-top: 10px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                glyph: Glyph.note;
                                icon-size: 16px;
                            }
                        }
                        Text {
                            text: "Notes";
                            font-size: 13px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                    notes-box := Scribble {
                        font-size: 13.5px;
                        min-lines: 3;
                        limit: 136px;
                        placeholder: "Details, links, a checklist… Enter starts a new line.";
                        text <=> root.notes;
                        active: root.active;
                        edited => { root.edited(); }
                        changed has-focus => {
                            if self.has-focus {
                                root.reveal(self.absolute-position.y, self.height);
                            }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    start-row := DateRow {
                        glyph: Glyph.calendar;
                        label: "Starts";
                        text <=> root.start;
                        placeholder: "tomorrow 9am, fri 14:00, +2h";
                        hint: root.start-hint;
                        active: root.active;
                        edited => { root.edited(); }
                        focused => { root.reveal(self.absolute-position.y, self.height); }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.stroke;
                    }
                    due-row := DateRow {
                        glyph: Glyph.flag;
                        label: "Due";
                        text <=> root.due;
                        placeholder: "fri 17:00, 10-20, next mon";
                        hint: root.due-hint;
                        active: root.active;
                        edited => { root.edited(); }
                        focused => { root.reveal(self.absolute-position.y, self.height); }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 2px;
                    HorizontalLayout {
                        height: 30px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                glyph: Glyph.bell;
                                icon-size: 16px;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "Reminders";
                            font-size: 13px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        if !root.can-add : Text {
                            text: "Set a start or due time first";
                            font-size: 12px;
                            color: Theme.text-3;
                            vertical-alignment: center;
                        }
                    }
                    for r[i] in root.reminders : ReminderLine {
                        data: r;
                        amount <=> r.amount;
                        hint: i < root.reminder-hints.length ? root.reminder-hints[i] : { text: "", error: false };
                        active: root.active;
                        cycle(d) => { root.cycle(i, d); }
                        remove => { root.remove(i); }
                        edited => { root.edited(); }
                        took-focus => {
                            root.track(i, true, false, self.absolute-position.y, self.height);
                        }
                        changed kind-focused => {
                            root.track(i, self.kind-focused, self.amount-focused, self.absolute-position.y, self.height);
                        }
                        changed amount-focused => {
                            root.track(i, self.kind-focused, self.amount-focused, self.absolute-position.y, self.height);
                        }
                    }
                    HorizontalLayout {
                        height: 40px;
                        padding-left: 20px;
                        alignment: LayoutAlignment.start;
                        VerticalLayout {
                            alignment: center;
                            add := FocusScope {
                                width: add-content.preferred-width;
                                height: 30px;
                                enabled: root.active;
                                changed has-focus => {
                                    if self.has-focus {
                                        root.reveal(self.absolute-position.y, self.height);
                                    }
                                }
                                Rectangle {
                                    border-radius: 5px;
                                    border-width: add.has-focus ? 1px : 0px;
                                    border-color: Theme.accent;
                                    background: add.has-focus ? Theme.accent-soft : add-touch.has-hover ? Theme.hover : transparent;
                                    add-content := HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: center;
                                            Icon {
                                                glyph: Glyph.plus;
                                                icon-size: 15px;
                                                tint: root.can-add ? Theme.accent : Theme.text-3;
                                            }
                                        }
                                        Text {
                                            text: "Add a reminder";
                                            font-size: 13px;
                                            color: root.can-add ? Theme.accent : Theme.text-3;
                                            vertical-alignment: center;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Keycap { text: root.add-keys; }
                                        }
                                    }
                                }
                                add-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.add-reminder(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------

component HelpPane inherits FocusScope {
    in property <[HelpRow]> rows;
    focus-on-click: true;

    key-pressed(e) => {
        if e.text == Key.DownArrow || e.text == Key.PageDown {
            flick.content-y = max(flick.content-y - (e.text == Key.PageDown ? flick.height : 108px), flick.height - flick.content-height);
            return accept;
        }
        if e.text == Key.UpArrow || e.text == Key.PageUp {
            flick.content-y = min(flick.content-y + (e.text == Key.PageUp ? flick.height : 108px), 0px);
            return accept;
        }
        reject
    }

    flick := Flickable {
        content-height: lines.preferred-height;
        lines := VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 12px;
            alignment: start;
            for r in root.rows : VerticalLayout {
                if r.section != "" : Text {
                    height: 36px;
                    text: r.section;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text-3;
                    vertical-alignment: center;
                }
                Rectangle {
                    height: 36px;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.stroke;
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            horizontal-stretch: 1;
                            text: r.label;
                            font-size: 13px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Keycap { text: r.keys; }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------

export component AppWindow inherits Window {
    title: "Wisp";
    icon: root.app-icon;
    no-frame: true;
    always-on-top: true;
    width: 680px;
    height: 520px;
    background: Theme.window;
    default-font-size: 14px;

    in property <image> app-icon;
    in-out property <View> view: View.inbox;

    in-out property <string> query;
    in property <[ItemRow]> items;
    in property <length> list-height;
    in-out property <int> selected: -1;
    in property <int> open-count;
    in property <int> done-count;
    in property <string> status;
    in property <string> clock-time;
    in property <string> clock-date;
    in property <string> empty-title;
    in property <string> empty-body;

    in-out property <string> edit-title;
    in-out property <string> edit-notes;
    in-out property <string> edit-start;
    in-out property <string> edit-due;
    in property <string> edit-meta;
    in property <string> back-label;
    in property <Hint> start-hint;
    in property <Hint> due-hint;
    in property <[ReminderRow]> reminders;
    in property <[Hint]> reminder-hints;
    in property <bool> can-add-reminder;
    in-out property <int> focused-reminder <=> editor.focused-reminder;

    in property <[HelpRow]> help;
    in property <Keys> keys;
    in property <string> toast;
    in property <bool> toast-error;

    // Every key press goes to Rust first, with where focus is; `true` means handled.
    callback key(text: string, ctrl: bool, alt: bool, shift: bool, meta: bool, context: string) -> bool;
    callback query-edited();
    callback row-clicked(int);
    callback row-opened(int);
    callback row-toggled(int);
    callback tab-clicked(int);
    callback settings-clicked();
    callback back-clicked();
    callback editor-edited();
    callback reminder-cycle(int, int);
    callback reminder-remove(int);
    callback reminder-add();

    public function focus-capture() {
        capture.take-focus();
        capture.cursor-to-end();
    }
    // 0 title, 1 notes, 2 starts, 3 due, 4 "add a reminder"
    public function focus-editor(field: int) {
        if field == 1 {
            editor.focus-notes();
        } else if field == 2 {
            editor.focus-start();
        } else if field == 3 {
            editor.focus-due();
        } else if field == 4 {
            editor.focus-add();
        } else {
            title-box.focus();
            title-box.set-selection-offsets(2147483647, 2147483647);
        }
    }
    public function focus-help() {
        help-pane.focus();
    }

    property <bool> listing: root.view == View.inbox || root.view == View.archive;
    property <bool> on-reminder: root.view == View.editor && root.focused-reminder >= 0 && !editor.notes-focused && !editor.date-focused && !editor.add-focused && !title-box.has-focus;

    pure function context() -> string {
        if capture.has-focus {
            return "capture";
        }
        if title-box.has-focus {
            return "edit-title";
        }
        if root.view == View.editor {
            if editor.notes-focused {
                return "edit-notes";
            }
            if editor.date-focused {
                return "edit-date";
            }
            if editor.add-focused {
                return "edit-add";
            }
            if root.focused-reminder >= 0 {
                return (editor.focused-part == 0 ? "edit-reminder-kind:" : "edit-reminder-amount:") + root.focused-reminder;
            }
            return "editor";
        }
        if root.view == View.help {
            return "help";
        }
        return "";
    }

    function scroll-to-selection() {
        if root.selected < 0 {
            list.content-y = 0;
        } else if root.selected < root.items.length {
            let r = root.items[root.selected];
            let bottom = r.top + (r.section != "" ? Theme.section-h : 0px) + Theme.row-h + 6px;
            if r.top < -list.content-y {
                list.content-y = -r.top;
            } else if bottom > -list.content-y + list.height {
                list.content-y = -(bottom - list.height);
            }
        }
    }
    changed selected => { root.scroll-to-selection(); }
    changed items => { root.scroll-to-selection(); }

    property <[KeyHint]> hints: root.view == View.editor ? (root.on-reminder ? (editor.focused-part == 0 ? [
        { keys: "← →", label: "Change type" },
        { keys: "Del", label: "Remove reminder" },
        { keys: "Esc", label: "Save and close" },
    ] : [
        { keys: root.keys.remove-reminder, label: "Remove reminder" },
        { keys: "Tab", label: "Next field" },
        { keys: "Esc", label: "Save and close" },
    ]) : editor.notes-focused ? [
        { keys: "Enter", label: "New line" },
        { keys: "Tab", label: "Next field" },
        { keys: "Esc", label: "Save and close" },
    ] : editor.date-focused ? [
        { keys: "Enter", label: "Save and close" },
        { keys: "Tab", label: "Next field" },
        { keys: root.keys.add-reminder, label: "Add reminder" },
    ] : editor.add-focused ? [
        { keys: "Enter", label: "Add reminder" },
        { keys: "Esc", label: "Save and close" },
    ] : [
        { keys: "Enter", label: "Go to notes" },
        { keys: "Esc", label: "Save and close" },
        { keys: root.keys.done, label: "Mark done" },
    ]) : root.view == View.help ? [
        { keys: "Esc", label: "Back" },
        { keys: "↑ ↓", label: "Scroll" },
    ] : root.selected >= 0 ? [
        { keys: "Enter", label: "Open" },
        { keys: root.keys.done, label: root.view == View.archive ? "Bring back" : "Mark done" },
        { keys: root.keys.delete, label: "Delete" },
        { keys: "Esc", label: "Back to typing" },
    ] : root.view == View.archive ? [
        { keys: "↓", label: "Browse" },
        { keys: root.keys.inbox, label: "Notes" },
        { keys: root.keys.settings, label: "Settings" },
        { keys: root.keys.help, label: "Shortcuts" },
    ] : [
        { keys: "Enter", label: "Save" },
        { keys: root.keys.schedule, label: "Save with a date" },
        { keys: "↓", label: "Browse" },
        { keys: root.keys.settings, label: "Settings" },
        { keys: root.keys.help, label: "Shortcuts" },
    ];

    router := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(e) => {
            if root.key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta, root.context()) {
                return accept;
            }
            reject
        }

        Rectangle {
            border-width: 1px;
            border-color: Theme.stroke;
            background: Theme.window;

            VerticalLayout {
                padding: 1px;

                // The search-box-style header.
                Rectangle {
                    height: root.listing ? max(66px, capture.height + 32px) : 66px;
                    HorizontalLayout {
                        padding-left: 15px;
                        padding-right: 10px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Tile {
                                tile-size: 36px;
                                glyph: root.view == View.archive ? Glyph.search : root.view == View.help ? Glyph.keyboard : Glyph.pen;
                                tone: 1;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            capture := Scribble {
                                y: (parent.height - self.height) / 2;
                                width: parent.width;
                                font-size: 19px;
                                limit: 112px;
                                visible: root.listing;
                                active: root.listing;
                                placeholder: root.view == View.archive ? "Search what's done" : "Type a thought. Enter saves it.";
                                text <=> root.query;
                                edited => { root.query-edited(); }
                            }
                            title-box := TextInput {
                                width: parent.width;
                                height: parent.height;
                                vertical-alignment: center;
                                single-line: true;
                                visible: root.view == View.editor;
                                enabled: root.view == View.editor;
                                font-size: 19px;
                                color: Theme.text;
                                selection-background-color: Theme.selection;
                                selection-foreground-color: Theme.text;
                                text-cursor-width: 2px;
                                text <=> root.edit-title;
                                edited => { root.editor-edited(); }
                            }
                            if root.view == View.editor && root.edit-title == "" : Text {
                                height: parent.height;
                                vertical-alignment: center;
                                text: "Title";
                                font-size: 19px;
                                color: Theme.text-3;
                            }
                            if root.view == View.help : Text {
                                height: parent.height;
                                vertical-alignment: center;
                                text: "Keyboard shortcuts";
                                font-size: 19px;
                                color: Theme.text;
                            }
                        }
                        if root.listing : VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.clock-time;
                                font-size: 16px;
                                font-weight: 600;
                                color: Theme.text;
                                horizontal-alignment: right;
                            }
                            Text {
                                text: root.clock-date;
                                font-size: 11px;
                                color: Theme.text-3;
                                horizontal-alignment: right;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                glyph: Glyph.gear;
                                clicked => { root.settings-clicked(); }
                            }
                        }
                    }
                }

                // Tabs while browsing; a way back while editing.
                Rectangle {
                    height: 38px;
                    if root.listing : HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 18px;
                        TabButton {
                            label: "Notes";
                            count: root.open-count;
                            active: root.view == View.inbox;
                            clicked => { root.tab-clicked(0); }
                        }
                        TabButton {
                            label: "Done";
                            count: root.done-count;
                            active: root.view == View.archive;
                            clicked => { root.tab-clicked(1); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.status;
                            font-size: 12px;
                            color: Theme.text-3;
                            vertical-alignment: center;
                        }
                    }
                    if !root.listing : HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 18px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 28px;
                                width: back-row.preferred-width;
                                border-radius: 5px;
                                background: back-touch.has-hover ? Theme.hover : transparent;
                                back-row := HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            glyph: Glyph.back;
                                            icon-size: 15px;
                                        }
                                    }
                                    Text {
                                        text: root.back-label;
                                        font-size: 13px;
                                        color: Theme.text-2;
                                        vertical-alignment: center;
                                    }
                                }
                                back-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.back-clicked(); }
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.view == View.editor ? root.edit-meta : "";
                            font-size: 12px;
                            color: Theme.text-3;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.stroke;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    clip: true;

                    list := Flickable {
                        visible: root.listing;
                        content-height: root.list-height + 10px;
                        for row[i] in root.items : NoteLine {
                            x: 0;
                            y: row.top + 4px;
                            width: list.width;
                            item: row;
                            selected: i == root.selected;
                            select => { root.row-clicked(i); }
                            open => { root.row-opened(i); }
                            toggle => { root.row-toggled(i); }
                        }
                    }
                    if root.listing && root.items.length == 0 : VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        padding-left: 40px;
                        padding-right: 40px;
                        padding-bottom: 24px;
                        HorizontalLayout {
                            alignment: center;
                            Tile {
                                tile-size: 52px;
                                glyph: root.view == View.archive ? Glyph.archive : Glyph.pen;
                                tone: 1;
                            }
                        }
                        Text {
                            text: root.empty-title;
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.text;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.empty-body;
                            font-size: 12.5px;
                            color: Theme.text-2;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    editor := EditorPane {
                        visible: root.view == View.editor;
                        active: root.view == View.editor;
                        notes <=> root.edit-notes;
                        start <=> root.edit-start;
                        due <=> root.edit-due;
                        start-hint: root.start-hint;
                        due-hint: root.due-hint;
                        reminders: root.reminders;
                        reminder-hints: root.reminder-hints;
                        can-add: root.can-add-reminder;
                        add-keys: root.keys.add-reminder;
                        edited => { root.editor-edited(); }
                        cycle(i, d) => { root.reminder-cycle(i, d); }
                        remove(i) => { root.reminder-remove(i); }
                        add-reminder => { root.reminder-add(); }
                    }

                    help-pane := HelpPane {
                        visible: root.view == View.help;
                        enabled: root.view == View.help;
                        rows: root.help;
                    }
                }

                // What the keys do right now, or the latest news.
                Rectangle {
                    height: 38px;
                    background: Theme.surface-alt;
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.stroke;
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 18px;
                        alignment: start;
                        if root.toast != "" : Text {
                            text: root.toast;
                            color: root.toast-error ? Theme.danger : Theme.accent;
                            font-size: 12.5px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if root.toast == "" : HorizontalLayout {
                            spacing: 18px;
                            for h in root.hints : KeyHintView {
                                keys: h.keys;
                                label: h.label;
                            }
                        }
                    }
                }
            }
        }
    }
}
