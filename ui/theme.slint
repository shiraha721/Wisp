// Colours, sizes and the icon set. The look follows Flow Launcher's Windows 11
// themes: quiet surfaces, one accent, rounded tiles, line icons.

import { Palette } from "std-widgets.slint";

export global Theme {
    in property <int> choice; // 0 follow the system, 1 light, 2 dark
    out property <bool> dark: choice == 2 || (choice == 0 && Palette.color-scheme == ColorScheme.dark);

    out property <color> window: dark ? #1f2023 : #f9f9fb;
    out property <color> surface: dark ? #2a2b2f : #ffffff;
    out property <color> surface-alt: dark ? #25262a : #f1f2f5;
    out property <color> field: dark ? #1c1d20 : #fbfbfc;
    out property <color> stroke: dark ? #36373c : #e3e5ea;
    out property <color> stroke-strong: dark ? #4a4c53 : #cdd1d8;
    out property <color> hover: dark ? #ffffff0d : #0000000a;
    out property <color> selected: dark ? #7aa2ff24 : #2b57d815;

    out property <color> text: dark ? #f3f4f6 : #1a1c21;
    out property <color> text-2: dark ? #c3c6cc : #575c66;
    out property <color> text-3: dark ? #8d9199 : #8b909a;

    out property <color> accent: dark ? #7aa2ff : #2b57d8;
    out property <color> accent-soft: dark ? #7aa2ff26 : #2b57d81a;
    out property <color> on-accent: dark ? #10183a : #ffffff;
    out property <color> danger: dark ? #ff8f8f : #c42b1c;
    out property <color> danger-soft: dark ? #ff8f8f24 : #c42b1c17;
    out property <color> success: dark ? #6ccb5f : #107c10;
    out property <color> success-soft: dark ? #6ccb5f24 : #107c1017;
    out property <color> neutral-soft: dark ? #ffffff12 : #0000000b;
    out property <color> selection: dark ? #7aa2ff55 : #2b57d840;

    out property <length> row-h: 58px;
    out property <length> section-h: 30px;

    // Category colours, by index (CATEGORY_COLORS in src/model.rs).
    public pure function tag(i: int) -> color {
        if i == 0 { return dark ? #7aa7ff : #2f6fe4; }
        if i == 1 { return dark ? #5fd08f : #1e9e57; }
        if i == 2 { return dark ? #ffaa55 : #e07a10; }
        if i == 3 { return dark ? #b99bff : #8150e0; }
        if i == 4 { return dark ? #ff8cc8 : #d43d8b; }
        if i == 5 { return dark ? #4fd6d3 : #0e9a9a; }
        if i == 6 { return dark ? #ffd25c : #c99400; }
        if i == 7 { return dark ? #ff8a80 : #d64234; }
        return text-3;
    }
    // The same colour, faint enough to sit behind text.
    public pure function tag-soft(i: int) -> color {
        return tag(i).with-alpha(dark ? 0.2 : 0.13);
    }
}

export enum Glyph {
    note,
    calendar,
    flag,
    bell,
    clock,
    check,
    search,
    gear,
    keyboard,
    bolt,
    moon,
    folder,
    power,
    window,
    info,
    pen,
    trash,
    undo,
    plus,
    archive,
    list,
    help,
    quit,
    cross,
    open,
    back,
    tag,
    globe,
}

// A line icon drawn on a 20×20 grid.
export component Icon inherits Path {
    in property <Glyph> glyph;
    in property <brush> tint: Theme.text-2;
    in property <length> icon-size: 18px;
    in property <length> weight: 1.5px;

    width: root.icon-size;
    height: root.icon-size;
    viewbox-width: 20;
    viewbox-height: 20;
    stroke: root.tint;
    stroke-width: root.weight;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    commands: root.path-for(root.glyph);

    pure function path-for(g: Glyph) -> string {
        if g == Glyph.note {
            return "M5.5 2.75 L11.75 2.75 L15.25 6.25 L15.25 17.25 L5.5 17.25 Z M11.5 3 L11.5 6.5 L15 6.5 M8 10 L12.5 10 M8 13 L12.5 13";
        }
        if g == Glyph.calendar {
            return "M3.75 5 L16.25 5 L16.25 16.5 L3.75 16.5 Z M3.75 8.5 L16.25 8.5 M7 3 L7 6 M13 3 L13 6";
        }
        if g == Glyph.flag {
            return "M5 17.5 L5 3 M5 3.75 L14.5 3.75 L12.5 7 L14.5 10.25 L5 10.25";
        }
        if g == Glyph.bell {
            return "M10 2.75 C7.4 2.75 5.75 4.7 5.75 7.2 L5.75 9.75 L4.25 12.75 L15.75 12.75 L14.25 9.75 L14.25 7.2 C14.25 4.7 12.6 2.75 10 2.75 Z M8.25 15.25 C8.6 16.6 11.4 16.6 11.75 15.25";
        }
        if g == Glyph.clock {
            return "M3.5 10 A6.5 6.5 0 1 1 16.5 10 A6.5 6.5 0 1 1 3.5 10 Z M10 6.25 L10 10 L12.75 11.75";
        }
        if g == Glyph.check {
            return "M4.75 10.5 L8.25 14 L15.25 6.25";
        }
        if g == Glyph.search {
            return "M3.25 8.75 A5.5 5.5 0 1 1 14.25 8.75 A5.5 5.5 0 1 1 3.25 8.75 Z M12.75 12.75 L16.75 16.75";
        }
        if g == Glyph.gear {
            return "M8.52 4.08 L8.79 1.89 L11.21 1.89 L11.48 4.08 A6.1 6.1 0 0 1 13.14 4.77 L14.88 3.41 L16.59 5.12 L15.23 6.86 A6.1 6.1 0 0 1 15.92 8.52 L18.11 8.79 L18.11 11.21 L15.92 11.48 A6.1 6.1 0 0 1 15.23 13.14 L16.59 14.88 L14.88 16.59 L13.14 15.23 A6.1 6.1 0 0 1 11.48 15.92 L11.21 18.11 L8.79 18.11 L8.52 15.92 A6.1 6.1 0 0 1 6.86 15.23 L5.12 16.59 L3.41 14.88 L4.77 13.14 A6.1 6.1 0 0 1 4.08 11.48 L1.89 11.21 L1.89 8.79 L4.08 8.52 A6.1 6.1 0 0 1 4.77 6.86 L3.41 5.12 L5.12 3.41 L6.86 4.77 A6.1 6.1 0 0 1 8.52 4.08 Z M7.3 10 A2.7 2.7 0 1 1 12.7 10 A2.7 2.7 0 1 1 7.3 10 Z";
        }
        if g == Glyph.keyboard {
            return "M2.75 5.25 L17.25 5.25 L17.25 14.75 L2.75 14.75 Z M5.75 8.25 L6 8.25 M8.5 8.25 L8.75 8.25 M11.25 8.25 L11.5 8.25 M14 8.25 L14.25 8.25 M5.75 10.75 L6 10.75 M14 10.75 L14.25 10.75 M7.75 12 L12.25 12";
        }
        if g == Glyph.bolt {
            return "M11.25 2.5 L4.75 11.25 L9.5 11.25 L8.75 17.5 L15.25 8.75 L10.5 8.75 Z";
        }
        if g == Glyph.moon {
            return "M15.75 12.25 A6.5 6.5 0 1 1 7.75 4.25 A5 5 0 0 0 15.75 12.25 Z";
        }
        if g == Glyph.folder {
            return "M2.75 5.25 L8 5.25 L9.75 7 L17.25 7 L17.25 15.75 L2.75 15.75 Z";
        }
        if g == Glyph.power {
            return "M10 2.75 L10 9.5 M6.25 5.25 A6.25 6.25 0 1 0 13.75 5.25";
        }
        if g == Glyph.window {
            return "M3 4 L17 4 L17 16 L3 16 Z M3 7 L17 7 M7.5 12.5 L12.5 12.5";
        }
        if g == Glyph.info {
            return "M3.5 10 A6.5 6.5 0 1 1 16.5 10 A6.5 6.5 0 1 1 3.5 10 Z M10 9 L10 13.5 M10 6.6 L10 6.7";
        }
        if g == Glyph.pen {
            return "M4 16 L4.75 12.75 L13 4.5 C13.7 3.8 14.8 3.8 15.5 4.5 C16.2 5.2 16.2 6.3 15.5 7 L7.25 15.25 Z M11.75 5.75 L14.25 8.25";
        }
        if g == Glyph.trash {
            return "M4 5.75 L16 5.75 M8 5.75 L8 3.75 L12 3.75 L12 5.75 M5.5 5.75 L6.25 16.25 L13.75 16.25 L14.5 5.75 M8.5 8.75 L8.5 13.25 M11.5 8.75 L11.5 13.25";
        }
        if g == Glyph.undo {
            return "M7.5 4.5 L4 8 L7.5 11.5 M4 8 L11.5 8 C14 8 16 10 16 12.25 C16 14.75 14 16.5 11.5 16.5 L8 16.5";
        }
        if g == Glyph.plus {
            return "M10 4.5 L10 15.5 M4.5 10 L15.5 10";
        }
        if g == Glyph.archive {
            return "M2.75 4.25 L17.25 4.25 L17.25 7.5 L2.75 7.5 Z M4 7.5 L4 15.75 L16 15.75 L16 7.5 M8 10.5 L12 10.5";
        }
        if g == Glyph.list {
            return "M7.5 5.5 L16 5.5 M7.5 10 L16 10 M7.5 14.5 L16 14.5 M4 5.5 L4.1 5.5 M4 10 L4.1 10 M4 14.5 L4.1 14.5";
        }
        if g == Glyph.help {
            return "M3.5 10 A6.5 6.5 0 1 1 16.5 10 A6.5 6.5 0 1 1 3.5 10 Z M8.1 8.1 C8.1 6.9 8.95 6.15 10 6.15 C11.05 6.15 11.9 6.9 11.9 7.95 C11.9 9.45 10 9.55 10 11.1 M10 13.6 L10 13.7";
        }
        if g == Glyph.quit {
            return "M8 3.5 L4 3.5 L4 16.5 L8 16.5 M12 6.5 L15.5 10 L12 13.5 M15.5 10 L7.5 10";
        }
        if g == Glyph.cross {
            return "M5.5 5.5 L14.5 14.5 M14.5 5.5 L5.5 14.5";
        }
        if g == Glyph.open {
            return "M7 4.5 L15.5 4.5 L15.5 13 M15.5 4.5 L5 15";
        }
        if g == Glyph.back {
            return "M8.5 4.75 L3.25 10 L8.5 15.25 M3.5 10 L16.75 10";
        }
        if g == Glyph.globe {
            return "M3.25 10 A6.75 6.75 0 1 1 16.75 10 A6.75 6.75 0 1 1 3.25 10 Z M3.5 10 L16.5 10 M10 3.25 C7.75 5.25 7.75 14.75 10 16.75 C12.25 14.75 12.25 5.25 10 3.25 Z";
        }
        if g == Glyph.tag {
            return "M3.25 4.5 C3.25 3.8 3.8 3.25 4.5 3.25 L9.75 3.25 L16.75 10.25 L10.25 16.75 L3.25 9.75 Z M6.75 6.75 L6.85 6.75";
        }
        return "M10 10 L10 10";
    }
}
