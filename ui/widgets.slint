// Small building blocks shared by the launcher and the settings window.

import { Theme, Glyph, Icon } from "theme.slint";

export component Keycap inherits Rectangle {
    in property <string> text;
    in property <bool> live;
    height: 22px;
    width: max(22px, label.preferred-width + 14px);
    border-radius: 5px;
    border-width: 1px;
    border-color: root.live ? Theme.accent : Theme.stroke-strong;
    background: root.live ? Theme.accent-soft : Theme.surface;
    // A heavier bottom edge, like a real key.
    Rectangle {
        x: 1px;
        y: parent.height - 2px;
        width: parent.width - 2px;
        height: 1px;
        background: root.live ? transparent : Theme.stroke;
    }
    label := Text {
        text: root.text;
        font-size: 11.5px;
        color: root.live ? Theme.accent : Theme.text-2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A shortcut shown as separate keys: [Ctrl] [Alt] [N].
export component KeyCombo inherits HorizontalLayout {
    in property <[string]> keys;
    in property <bool> live;
    spacing: 4px;
    for k in root.keys : VerticalLayout {
        alignment: center;
        Keycap {
            text: k;
            live: root.live;
        }
    }
}

export component KeyHintView inherits HorizontalLayout {
    in property <string> keys;
    in property <string> label;
    spacing: 6px;
    VerticalLayout {
        alignment: center;
        Keycap { text: root.keys; }
    }
    Text {
        text: root.label;
        font-size: 12px;
        color: Theme.text-3;
        vertical-alignment: center;
    }
}

// A rounded square with an icon, like an app icon in Flow Launcher's results.
// `tone`: 0 neutral, 1 accent, 2 danger, 3 success.
export component Tile inherits Rectangle {
    in property <Glyph> glyph;
    in property <int> tone;
    in property <length> tile-size: 34px;
    // Shows a check mark, inviting a click.
    in property <bool> hot;
    property <brush> ink: root.tone == 1 ? Theme.accent : root.tone == 2 ? Theme.danger : root.tone == 3 ? Theme.success : Theme.text-2;
    width: root.tile-size;
    height: root.tile-size;
    border-radius: root.tile-size * 0.28;
    background: root.tone == 1 ? Theme.accent-soft : root.tone == 2 ? Theme.danger-soft : root.tone == 3 ? Theme.success-soft : Theme.neutral-soft;
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.hot ? Glyph.check : root.glyph;
        tint: root.ink;
        icon-size: root.tile-size * 0.56;
        weight: 1.6px;
    }
}

// A category's colour, as a dot.
export component TagDot inherits Rectangle {
    in property <int> tint;
    in property <length> size: 8px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: Theme.tag(root.tint);
}

// A category as a pill: "● Work". `tint` -1 has no dot ("All", "None"). `chosen`
// fills it; `ring` outlines it while the keyboard is on it.
export component TagChip inherits Rectangle {
    in property <string> label;
    in property <int> tint: -1;
    in property <bool> chosen;
    in property <bool> ring;
    callback clicked();
    height: 24px;
    width: row.preferred-width;
    border-radius: 12px;
    background: root.chosen ? (root.tint >= 0 ? Theme.tag-soft(root.tint) : Theme.accent-soft) : touch.has-hover ? Theme.hover : transparent;
    border-width: root.ring ? 1.5px : 0px;
    border-color: Theme.accent;
    row := HorizontalLayout {
        padding-left: root.tint >= 0 ? 9px : 11px;
        padding-right: 11px;
        spacing: 6px;
        if root.tint >= 0 : VerticalLayout {
            alignment: center;
            TagDot { tint: root.tint; }
        }
        Text {
            text: root.label;
            font-size: 12.5px;
            color: root.chosen ? Theme.text : Theme.text-2;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Card inherits Rectangle {
    in property <bool> focused;
    background: Theme.surface;
    border-radius: 8px;
    border-width: root.focused ? 2px : 1px;
    border-color: root.focused ? Theme.accent : Theme.stroke;
}

export component Switch inherits Rectangle {
    in property <bool> on;
    width: 40px;
    height: 20px;
    border-radius: 10px;
    background: root.on ? Theme.accent : transparent;
    border-width: root.on ? 0px : 1px;
    border-color: Theme.text-2;
    Rectangle {
        width: root.on ? 12px : 10px;
        height: self.width;
        border-radius: self.width / 2;
        y: (parent.height - self.height) / 2;
        x: root.on ? parent.width - self.width - 4px : 5px;
        animate x { duration: 120ms; easing: ease-out; }
        background: root.on ? Theme.on-accent : Theme.text-2;
    }
}

export component IconButton inherits Rectangle {
    in property <Glyph> glyph;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: touch.pressed ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        tint: touch.has-hover ? Theme.text : Theme.text-2;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PushButton inherits Rectangle {
    in property <string> text;
    in property <Glyph> glyph;
    in property <bool> has-glyph;
    // The window's main action, in the accent colour.
    in property <bool> primary;
    // Has the keyboard: a ring around it.
    in property <bool> focused;
    callback clicked();
    height: root.primary ? 34px : 30px;
    width: label.preferred-width + (root.has-glyph ? 50px : root.primary ? 40px : 30px);
    border-radius: 5px;
    border-width: 1px;
    border-color: root.primary ? Theme.accent : Theme.stroke-strong;
    background: root.primary
        ? (touch.pressed ? Theme.accent.darker(0.15) : touch.has-hover ? Theme.accent.brighter(0.08) : Theme.accent)
        : (touch.pressed ? Theme.selected : touch.has-hover ? Theme.surface-alt : Theme.surface);
    Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: 8px;
        border-width: root.focused ? 2px : 0px;
        border-color: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;
        alignment: center;
        if root.has-glyph : VerticalLayout {
            alignment: center;
            Icon {
                glyph: root.glyph;
                icon-size: 15px;
                tint: Theme.text;
            }
        }
        label := Text {
            text: root.text;
            font-size: 13px;
            font-weight: root.primary ? 600 : 400;
            color: root.primary ? Theme.on-accent : Theme.text;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// An icon and a short text, for the second line of a note.
export component Meta inherits HorizontalLayout {
    in property <Glyph> glyph;
    in property <string> text;
    in property <bool> alert;
    horizontal-stretch: 0;
    spacing: 4px;
    VerticalLayout {
        alignment: center;
        Icon {
            glyph: root.glyph;
            icon-size: 13px;
            weight: 1.4px;
            tint: root.alert ? Theme.danger : Theme.text-3;
        }
    }
    Text {
        text: root.text;
        font-size: 12px;
        color: root.alert ? Theme.danger : Theme.text-2;
        vertical-alignment: center;
    }
}

// A multi-line input that grows with its text, up to `limit`, then scrolls.
export component Scribble inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <length> font-size: 20px;
    in property <length> limit: 120px;
    in property <int> min-lines: 1;
    in property <bool> active: true;
    in property <color> ink: Theme.text;
    out property <bool> has-focus: input.has-focus;
    callback edited();
    property <length> line: root.font-size * 1.4;

    public function take-focus() {
        input.focus();
    }
    public function cursor-to-end() {
        input.set-selection-offsets(2147483647, 2147483647);
    }

    height: min(max(input.preferred-height, root.line * root.min-lines), root.limit);

    flick := Flickable {
        width: parent.width;
        height: parent.height;
        content-width: self.width;
        content-height: max(input.preferred-height, self.height);
        interactive: false;

        input := TextInput {
            width: flick.width;
            height: flick.content-height;
            single-line: false;
            wrap: word-wrap;
            enabled: root.active;
            font-size: root.font-size;
            color: root.ink;
            selection-background-color: Theme.selection;
            selection-foreground-color: Theme.text;
            text-cursor-width: 2px;
            edited => { root.edited(); }
            cursor-position-changed(p) => {
                if p.y < -flick.content-y {
                    flick.content-y = -p.y;
                } else if p.y + root.line > -flick.content-y + flick.height {
                    flick.content-y = -(p.y + root.line - flick.height);
                }
            }
        }
    }

    if input.text == "" : Text {
        x: 0;
        y: 0;
        text: root.placeholder;
        font-size: root.font-size;
        color: Theme.text-3;
    }
}

// A one-line text box in the Windows 11 style: an accent underline while focused.
export component InputBox inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> active: true;
    in property <length> font-size: 13.5px;
    out property <bool> has-focus: input.has-focus;
    callback edited();

    public function take-focus() {
        input.focus();
        input.select-all();
    }

    height: 30px;
    clip: true;
    border-radius: 5px;
    background: input.has-focus ? Theme.surface : Theme.field;
    border-width: 1px;
    border-color: input.has-focus ? Theme.stroke-strong : Theme.stroke;
    Rectangle {
        x: 1px;
        y: parent.height - 2px;
        width: parent.width - 2px;
        height: 2px;
        border-radius: 1px;
        background: input.has-focus ? Theme.accent : transparent;
    }
    input := TextInput {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        enabled: root.active;
        font-size: root.font-size;
        color: Theme.text;
        selection-background-color: Theme.selection;
        selection-foreground-color: Theme.text;
        text-cursor-width: 1.5px;
        edited => { root.edited(); }
    }
    if input.text == "" : Text {
        x: input.x;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.text-3;
        font-size: root.font-size;
    }
}
